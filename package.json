{
  "name": "sentoarc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "vite",
    "build": "vite build && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "vite build",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sentoarc-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sentoarc-db --remote"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "hono": "^4.6.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.4",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.6",
    "wrangler": "^3.91.0"
  }
}
